# Copy to `.env` (gitignored). Every value has a working default, so a fresh
# checkout builds and searches without any of this.

# USDA FoodData Central API key (https://fdc.nal.usda.gov/api-key-signup).
# DEMO_KEY works for development, at a lower rate limit.
USDA_API_KEY=DEMO_KEY

# Contact address Open Food Facts requires in the User-Agent of every request.
# Set the owner's real address before publishing.
APP_CONTACT_EMAIL=contato@bocado.app
