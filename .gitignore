# Environment
.env

# JS bundle and assets generated by `react-native bundle` for device tests.
# Only the bundler's own copies are ignored: the brand rasters under
# drawable-*dpi (splash_icon) are build inputs and must be in the repository.
android/app/src/main/assets/index.android.bundle
android/app/src/main/assets/index.android.bundle.map
android/app/src/main/res/drawable-*/node_modules_*
android/app/src/main/res/drawable-*/assets_*
android/app/src/main/res/drawable-*/src_*
android/app/src/main/res/raw/

